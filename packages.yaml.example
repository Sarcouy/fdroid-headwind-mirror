repo:
  url: https://f-droid.org/repo
  # Declare mais pas encore verifie: le service telecharge entry.json, qui n'est pas signe.
  # La protection repose aujourd'hui sur HTTPS et sur la chaine d'empreintes sha256.
  fingerprint: 43238d512c1e5eb2d6569f4a3afbf5523418b82e0a3ed1552770abb9a9c9ccab

defaults:
  mirror: true
  auto_approve: false
  target_abis: [arm64-v8a]
  blocked_anti_features: []

packages:
  - pkg: org.mozilla.fennec_fdroid
    auto_approve: true
  - pkg: com.nextcloud.client
  - pkg: org.videolan.vlc
    mirror: false

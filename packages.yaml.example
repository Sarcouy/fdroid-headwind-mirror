repo:
  url: https://f-droid.org/repo
  # Declared but not verified yet: the service downloads entry.json, which is not signed.
  # Protection currently relies on HTTPS and on the chain of sha256 hashes.
  fingerprint: 43238d512c1e5eb2d6569f4a3afbf5523418b82e0a3ed1552770abb9a9c9ccab

defaults:
  auto_approve: false
  target_abis: [arm64-v8a]
  blocked_anti_features: []

packages:
  - pkg: org.mozilla.fennec_fdroid
    auto_approve: true
  - pkg: com.nextcloud.client
  - pkg: org.videolan.vlc

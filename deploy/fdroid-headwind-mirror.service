[Unit]
Description=Synchronise F-Droid updates to Headwind MDM
Documentation=https://github.com/Sarcouy/fdroid-headwind-mirror
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fdroid-headwind-mirror
Group=fdroid-headwind-mirror

# The default paths of packages.yaml, state.db and .cache are relative:
# without WorkingDirectory the service looks for them elsewhere than where they are.
WorkingDirectory=/var/lib/fdroid-headwind-mirror

# FHM_HEADWIND_PASSWORD lives in this file, readable by the service user only
# (chmod 600). Never write the secret into the unit: it is world-readable.
EnvironmentFile=/etc/fdroid-headwind-mirror/env

ExecStart=/opt/fdroid-headwind-mirror/.venv/bin/fhm sync --apply

# The service only writes to its working directory and serves no socket.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fdroid-headwind-mirror
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target

# Copy to /etc/fdroid-headwind-mirror/env, then restrict its permissions:
#   chown root:fdroid-headwind-mirror /etc/fdroid-headwind-mirror/env
#   chmod 640 /etc/fdroid-headwind-mirror/env
#
# The password must never appear in the systemd unit, which is world-readable.

FHM_HEADWIND_URL=https://mdm.example.org
FHM_HEADWIND_LOGIN=replace-with-the-login-of-the-service-user
FHM_HEADWIND_PASSWORD=replace-with-the-password-of-the-service-user
FHM_PACKAGES_FILE=/var/lib/fdroid-headwind-mirror/packages.yaml
FHM_DATABASE_PATH=/var/lib/fdroid-headwind-mirror/state.db
FHM_CACHE_DIR=/var/lib/fdroid-headwind-mirror/.cache

[Unit]
Description=Daily trigger of the F-Droid to Headwind MDM synchronisation

[Timer]
OnCalendar=daily

# Spreads the calls to f-droid.org: a fleet of services all triggering at midnight
# sharp needlessly concentrates the load on the repository.
RandomizedDelaySec=2h

# Catches up on the run if the machine was off at the scheduled time.
Persistent=true

Unit=fdroid-headwind-mirror.service

[Install]
WantedBy=timers.target
